# Local secrets for development. Copy to .env.development (git-ignored, read from the main checkout by
# every worktree) and fill in. Never commit real values.

# Clerk *development* instance secret key (Clerk dashboard > Development > API keys). Only sk_test_ keys are
# accepted. `npm run dev` in a worktree uses it (apps/desktop/tools/dev-account.mjs) to sign the sandbox into
# its own test account, and `npm run dev -- --prune` to delete that account again.
CODYNC_CLERK_SECRET_KEY=sk_test_replace_me
