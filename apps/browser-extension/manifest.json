{
  "manifest_version": 3,
  "name": "Codync Browser",
  "version": "0.1.0",
  "description": "Lets a Codync bot operate a dedicated tab on this computer and return screenshots to the same chat.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Codync Browser",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120"
}
