{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/:path((?!e/).+)/", "destination": "/:path", "permanent": true },
    { "source": "/wechat", "destination": "https://applink.feishu.cn/client/chat/chatter/add_by_link?link_token=49eq6f1e-ef72-40d8-aaf9-9864ee289ba3", "permanent": false }
  ],
  "rewrites": [{ "source": "/e/:path(.*)", "destination": "https://us.i.posthog.com/:path" }],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "dev": true
    }
  }
}
