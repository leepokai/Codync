{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/:path((?!e/).+)/", "destination": "/:path", "permanent": true }],
  "rewrites": [{ "source": "/e/:path(.*)", "destination": "https://us.i.posthog.com/:path" }],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "dev": true
    }
  }
}
